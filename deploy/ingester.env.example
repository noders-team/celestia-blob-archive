# /etc/celestia-blob-archive/mocha.env — mode 0600, owner root.
# Placeholder values only; never commit real credentials.

# Consensus node gRPC (host:port) and whether it uses TLS.
CBA_GRPC=127.0.0.1:9090
CBA_GRPC_TLS=false

# R2 bucket and write credentials (scoped to this bucket only).
CBA_BUCKET=example-bucket
# PUT If-None-Match: * for immutable objects (verified on R2, see tools/phase0/README.md)
#CBA_CONDITIONAL_PUT=true
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# op-alt-da fallback objects (op/<ns>/<keccak>) for these namespaces:
# comma-separated 29-byte hex, reserved namespaces rejected. Empty disables
# writing and clears op/_namespaces.json at the next start.
#CBA_OP_NAMESPACES=00000000000000000000000000000000000000ca1de12ac5a629c3c42f

# fibre-capture (`ingester fibre-capture`, its own unit): CBA_GRPC is also the
# fibre client's state address, always plaintext (fibre-capture refuses
# CBA_GRPC_TLS=true). The state directory
# defaults to systemd's $STATE_DIRECTORY (StateDirectory= of the unit).
#CBA_FIBRE_STATE_DIR=/var/lib/cba-fibre-mocha
# Bytes downloaded per UTC day at most (decimal; default 50 GB).
#CBA_FIBRE_DAILY_CAP_BYTES=50000000000

# Alternative for testing: write to a local directory instead of R2.
# With ProtectSystem=strict the directory must also be listed in
# ReadWritePaths= of the unit.
#CBA_FS_ROOT=/var/lib/celestia-blob-archive
